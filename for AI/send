    .nav-bar {
    display: flex;
    justify-content: center;
    background-color: transparent;

    width: 100%;
    padding: 10px 15px;
    flex-wrap: wrap;
    position: absolute;
    z-index: 100;
}

.nav-bar .contener {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
}

.nav-bar .contener div:first-child img {
    max-width: 100px;
}

.nav-bar .moniter nav ul:first-child {
    display: flex;
    column-gap: 18px;

}

.nav-bar .moniter nav ul li a {
    font-size: 13px;
}
.nav-bar .moniter nav ul li a.active{
    color: var(--text-color-y);
}

.nav-bar .moniter nav ul li:nth-child(3)::after {
    content: "\f078";
    font-weight: 900;
    padding-left: 5px;
    font-family: "Font Awesome 6 Free";
    font-size: 13px;
    color: var(--rev-wh-color);
    cursor: pointer;
        transition: all .2s linear;

}

.nav-bar nav ul li:nth-child(3){
    position: relative;
}

.nav-bar nav .extra {
    display: none;
    transition: all 0.8s;
}

.nav-bar nav ul li:nth-child(3):hover .extra {
    position: absolute;
    width: 200px;
    top: 30px;
    row-gap: 1px;
    left: -12px;
    display: block;
    flex-direction: column;
    transition: all 0.8s ;

}

.nav-bar .extra li a {
    display: inline-block;
}

.nav-bar nav .extra a {
    padding: 12px 25px;
    color: var(--rev-bl-color);
    background-color: var(--rev-wh-color);
}
.nav-bar nav .extra a:hover{
    background-color: var(--text-color-y);
    color: var(--rev-wh-color);
}

.nav-bar nav .extra a.active{
    background-color: var(--text-color-y);
    color: var(--rev-wh-color);
}

.nav-toggle {
  display: none;
}

.nav-bar .mobile {
    display: none;
}

.nav-bar .mobile nav ul li {
    border-bottom: 1px solid var(--rev-bl-color);
}
.nav-bar .mobile nav ul li a.active{
   background-color: var(--text-color-y);
    color: var(--rev-wh-color);;
}

.nav-bar .mobile nav li:nth-child(3):hover .extra {
    max-width: 250px;
    top: 72px;
    left: 12px;
}

.nav-bar .mobile nav .extra a {
    padding: 12px 15px;
}

.nav-bar .mobile nav .extra li{
    display: inline-block;
}

.nav-bar nav ul li a:hover {
    color: var(--text-color-y);
}





