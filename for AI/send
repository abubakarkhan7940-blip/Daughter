                    .nav-bar .moniter nav ul li:nth-child(3)::after {
    content: "\f078";
    font-weight: 900;
    padding-left: 5px;
    font-family: "Font Awesome 6 Free";
    font-size: 13px;
    color: var(--rev-wh-color);
    cursor: pointer;
    transition: all .2s linear;
}

.nav-bar nav ul li:nth-child(3) {
    position: relative;
}

.nav-bar nav .extra {
    display: none;
    transition: all 0.8s;
}

.nav-bar nav ul li:nth-child(3):hover .extra {
    position: absolute;
    width: 200px;
    top: 30px;
    row-gap: 1px;
    left: -12px;
    display: block;
    flex-direction: column;
    transition: all 0.8s;
}

.nav-bar .extra li a {
    display: inline-block;
}

.nav-bar nav .extra a {
    padding: 12px 25px;
    color: var(--rev-bl-color);
    background-color: var(--rev-wh-color);
}

/* Updated extra dropdown links to share hover & active consistency */
.nav-bar nav .extra a:hover,
.nav-bar nav .extra a.active {
    background-color: var(--text-color-y) !important;
    color: var(--rev-wh-color) !important;
}

